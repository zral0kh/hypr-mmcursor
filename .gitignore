# Everything here is reproducible from a checkout; see "Artifacts and provenance"
# in README.md for how each one is produced or fetched.

# make test / make plugin
build/
*.so
*.o

# make -C test/vpointer — generated by wayland-scanner from the vendored XML.
# The XML itself IS tracked (nothing on the system ships it; see README).
test/vpointer/vpointer
test/vpointer/*-protocol.c
test/vpointer/*-client-protocol.h

# Generated inside the VM by verify-autoload.sh from test/vm/hyprland.conf.
test/vm/hyprland-autoload.conf

# Editor / tooling
compile_commands.json
.cache/

# Maintainer-local notes. Prose about how we work is not a user's problem.
# Tooling is different — scripts/release.sh is tracked, the same way a CI
# workflow would be.
RELEASING.md
NOTES.local.md